#!/usr/bin/env bash
# memory-audit: deterministic nightly audit of the personal memory system.
# Evaluates the disciplines; the only write it ever performs is auto-healing
# UTC-misfiled daily logs (merge into today's log, misdated file moved to a
# recoverable trash dir). Everything else is read-only.
# Usage: memory-audit [memory-root] | memory-audit --help
#   memory root defaults to $PERSONAL_MEMORY_ROOT, then $HOME.
#   Set $MEMORY_WATERMARK_FILE to also check the refresh job's watermark
#   (installation-specific; skipped when unset).
# Env:
#   MEMORY_AUDIT_TZ   IANA timezone for "today" (e.g. America/Los_Angeles).
#     "Today" is always the user's local date, never the machine's clock —
#     a 10 PM run on a UTC machine must not read tomorrow's date.
#     Defaults to $TZ, then UTC. Installations should set this explicitly.
#   MEMORY_AUDIT_TRASH_DIR
#     where auto-healed misdated logs are moved (recoverable; not
#     auto-expired). Defaults to $ROOT/.audit-trash.
# Exit: 0 = clean, 1 = issues found, 2 = secrets found (from memory-guard).
set -u

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "usage: memory-audit [memory-root]"
  echo "  Deterministic nightly audit: guard scan, trace format, expiry,"
  echo "  stale open threads, duplication drift, daily-log dating,"
  echo "  refresh watermark, installation literals absent from skill,"
  echo "  index integrity (dangling refs, locations page schema),"
  echo "  router integrity (MEMORY.md single-home rule),"
  echo "  retrieval query expectation staleness (v2 suite ground truth)."
  echo "  Read-only except auto-healing UTC-misfiled daily logs"
  echo "  (merge into today's log; misdated file -> recoverable trash)."
  echo "  Set MEMORY_RETRIEVAL_QUERIES to the v2 query JSONL to enable"
  echo "  check 11 (default: ~/workspace/goals/daily-memory-refresh/"
  echo "  hidden_files/retrieval-queries-v2.jsonl when it exists)."
  echo "  exit 0 = clean, 1 = issues found, 2 = secrets found."
  exit 0
fi

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${1:-${PERSONAL_MEMORY_ROOT:-$HOME}}"
MEM="$ROOT/memory"
AUDIT_TZ="${MEMORY_AUDIT_TZ:-${TZ:-UTC}}"
TODAY="$(TZ="$AUDIT_TZ" date +%F)"
CUTOFF="$(TZ="$AUDIT_TZ" date -d '30 days ago' +%F 2>/dev/null || TZ="$AUDIT_TZ" date -v-30d +%F)"
ISSUES=0

say()  { printf '%s\n' "$*"; }
flag() { say "  ! $*"; ISSUES=1; }

say "# memory-audit — $TODAY (root: $ROOT)"
say ""

# 1. guard scan -----------------------------------------------------------
say "## 1. guard scan"
guard_out="$("$SKILL_DIR/bin/memory-guard" 2>&1)"
guard_status=$?
say "$guard_out" | sed 's/^/  /'
if [ "$guard_status" -eq 1 ]; then
  flag "SECRETS detected — investigate before any further write."
  say ""
  echo "AUDIT RESULT: secrets found"
  exit 2
elif [ "$guard_status" -eq 2 ]; then
  flag "financial figures present — flagged for human review."
fi
say ""

# 2. trace format ---------------------------------------------------------
say "## 2. trace format (top 40 entries)"
bad=0
if [ -f "$MEM/trace/trace.md" ]; then
  while IFS= read -r line; do
    case "$line" in
      "- ["*)
        if ! printf '%s' "$line" | grep -q '|.*|' || \
           ! printf '%s' "$line" | grep -q '(src:'; then
          flag "malformed entry: $line"
          bad=1
        fi
        ;;
    esac
  done < <(grep '^- \[' "$MEM/trace/trace.md" | head -40)
  [ "$bad" -eq 0 ] && say "  ok — all entries one-line, typed, sourced."
else
  flag "trace.md missing."
fi
say ""

# 3. expired valid_until --------------------------------------------------
say "## 3. expired valid_until still open"
expired=0
if [ -f "$MEM/trace/trace.md" ]; then
  while IFS= read -r line; do
    d="$(printf '%s' "$line" | grep -oE 'valid_until: [0-9]{4}-[0-9]{2}-[0-9]{2}' | head -1 | awk '{print $2}')"
    if [ -n "$d" ] && [[ "$d" < "$TODAY" ]]; then
      # retired entries stay silent: skip when a closed/superseded entry
      # references the same area + date (the retirement, not the expiry,
      # is the current state)
      area="$(printf '%s' "$line" | grep -oE '^- \[[^]]+\]' | head -1)"
      if [ -n "$area" ] && grep -F -- "$area" "$MEM/trace/trace.md" 2>/dev/null | \
           grep -qE "(closed|superseded).*${d}|${d}.*(closed|superseded)"; then
        continue
      fi
      case "$line" in
        *open*|*new*|*updated*)
          flag "expired $d not retired: $(printf '%s' "$line" | cut -c1-100)"
          expired=1
          ;;
      esac
    fi
  done < <(grep 'valid_until:' "$MEM/trace/trace.md")
  [ "$expired" -eq 0 ] && say "  ok — nothing past due and still open."
fi
say ""

# 4. open threads older than 30 days ---------------------------------------
say "## 4. open threads older than 30 days"
stale=0
if [ -f "$MEM/trace/trace.md" ]; then
  while IFS= read -r line; do
    d="$(printf '%s' "$line" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | tail -1)"
    if [ -n "$d" ] && [[ "$d" < "$CUTOFF" ]]; then
      flag "stale open thread (src date $d): $(printf '%s' "$line" | cut -c1-100)"
      stale=1
    fi
  done < <(grep '^- \[.*open' "$MEM/trace/trace.md")
  [ "$stale" -eq 0 ] && say "  ok — no open thread older than 30 days."
fi
say ""

# 5. duplication drift ----------------------------------------------------
say "## 5. duplication drift (long lines repeated across curated files)"
tmp="$(mktemp)"
curated=("$ROOT/MEMORY.md" "$MEM/personalization.md")
for f in "$MEM"/people/*.md "$MEM"/groups/*.md "$MEM"/topics/*.md; do
  [ -e "$f" ] && curated+=("$f")
done
[ -n "${PERSONAL_MEMORY_PROFILE:-}" ] && [ -e "$PERSONAL_MEMORY_PROFILE" ] \
  && curated+=("$PERSONAL_MEMORY_PROFILE")
for f in "${curated[@]}"; do
  [ -f "$f" ] && awk -v F="$f" 'length > 140 {print $0 "	@@@" F}' "$f"
done | sort -t '	' -k1,1 | awk -F'	' '{print $1}' | uniq -d > "$tmp"
if [ -s "$tmp" ]; then
  while IFS= read -r line; do
    files="$(for f in "${curated[@]}"; do grep -lF -- "$line" "$f" 2>/dev/null; done | tr '\n' ' ')"
    flag "duplicated passage: $(printf '%s' "$line" | cut -c1-80)…"
    say "      in: $files"
  done < "$tmp"
else
  say "  ok — no long passage repeated across curated files."
fi
rm -f "$tmp"
say ""

# 6. daily log dating ------------------------------------------------------
say "## 6. daily log dating (local date: $TODAY, tz: $AUDIT_TZ)"
if [ -f "$MEM/$TODAY.md" ]; then
  say "  ok — today's log exists."
else
  flag "today's daily log ($TODAY.md) is missing."
fi
# Auto-heal (the audit's only write path): UTC-misfiled future logs are
# merged into today's log with a provenance marker, and the misdated file
# is moved to a recoverable trash dir. Only strict YYYY-MM-DD names are
# healed; anything else keeps the old flag. Past logs are history — never
# touched.
TRASH_DIR="${MEMORY_AUDIT_TRASH_DIR:-$ROOT/.audit-trash}"
future="$(find "$MEM" -maxdepth 1 -name '20*.md' | while read -r f; do
  b="$(basename "$f" .md)"
  if [[ "$b" > "$TODAY" ]]; then echo "$b"; fi
done | sort)"
if [ -n "$future" ]; then
  mkdir -p "$TRASH_DIR" 2>/dev/null \
    || flag "cannot create trash dir $TRASH_DIR — future logs left in place."
  issues_before=$ISSUES
  healed=0
  while IFS= read -r b; do
    [ -d "$TRASH_DIR" ] || continue
    f="$MEM/$b.md"
    [ -f "$f" ] || continue
    if ! [[ "$b" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
      flag "future-dated log with non-date name: $b.md (not auto-healed)"
      continue
    fi
    dest="$TRASH_DIR/$b.md"
    [ -e "$dest" ] && dest="$TRASH_DIR/$b.$(date +%s).md"
    if [ -s "$f" ]; then
      { printf '\n<!-- memory-audit auto-heal %s: merged misdated log %s (UTC-misfiled) -->\n' "$TODAY" "$b.md"
        cat "$f"; } >> "$MEM/$TODAY.md" 2>/dev/null \
        && mv "$f" "$dest" 2>/dev/null && [ ! -e "$f" ] \
        && { say "  healed — merged $b.md into $TODAY.md; misdated file -> $dest"; healed=1; } \
        || flag "failed to heal $b.md (left in place)"
    else
      mv "$f" "$dest" 2>/dev/null && [ ! -e "$f" ] \
        && { say "  healed — empty misdated log $b.md -> $dest"; healed=1; } \
        || flag "failed to move empty $b.md to trash (left in place)"
    fi
  done <<< "$future"
  [ "$healed" -eq 1 ] && [ "$ISSUES" -eq "$issues_before" ] \
    && say "  ok — no future-dated logs remain."
else
  say "  ok — no future-dated logs."
fi
say ""

# 7. refresh watermark -----------------------------------------------------
say "## 7. refresh watermark"
if [ -n "${MEMORY_WATERMARK_FILE:-}" ]; then
  if [ -f "$MEMORY_WATERMARK_FILE" ]; then
    w="$(head -1 "$MEMORY_WATERMARK_FILE" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' || true)"
    if [ -n "$w" ] && [[ "$w" < "$CUTOFF" ]]; then
      flag "watermark ($w) is stale — the refresh job may have missed runs."
    else
      say "  ok — watermark: ${w:-unparsed}."
    fi
  else
    flag "watermark file $MEMORY_WATERMARK_FILE missing."
  fi
else
  say "  skipped — MEMORY_WATERMARK_FILE not set."
fi
say ""

# 8. public skill free of installation-sensitive literals -------------------
say "## 8. public skill free of installation-sensitive literals"
DENYLIST="${MEMORY_EGRESS_DENYLIST:-$ROOT/memory/.egress-denylist}"
if [ -s "$DENYLIST" ]; then
  deny_tmp="$(mktemp)"
  grep -vE '^[[:space:]]*(#|$)' "$DENYLIST" > "$deny_tmp"
  if [ -s "$deny_tmp" ]; then
    leak=$(grep -rF -f "$deny_tmp" "$SKILL_DIR" --exclude-dir=.git 2>/dev/null | head -5 || true)
    if [ -n "$leak" ]; then
      flag "installation-sensitive literals found in the public skill:"
      printf '%s\n' "$leak" | sed 's/^/  /'
    else
      say "  ok — no denylisted literals in the skill repo."
    fi
  else
    say "  skipped — denylist empty."
  fi
  rm -f "$deny_tmp"
else
  say "  skipped — no egress denylist configured."
fi
say ""

# 9. index integrity -------------------------------------------------------
say "## 9. index integrity (dangling refs + locations page schema)"
idx_tmp="$(mktemp)"
# 9a. every backtick-quoted page path in an area INDEX.md must resolve to
# a real file inside that area's own tree. Cross-area links are out of
# scope here — only strict in-area refs are checked. Template placeholders
# (e.g. `YYYY-MM-DD-<slug>.md` in a "Filename convention" line) are not
# refs and are skipped.
for area in people groups topics meetings activities interests locations; do
  idx="$MEM/$area/INDEX.md"
  [ -f "$idx" ] || continue
  grep -o '`[^`]*\.md`' "$idx" 2>/dev/null | tr -d '`' | while IFS= read -r p; do
    case "$p" in
      *\<*|*\>*) continue ;; # template placeholder, not a page ref
      '~/memory/'*) target="$MEM/${p#\~/memory/}" ;;
      '~/'*)        target="$ROOT/${p#\~/}" ;;
      /*)           target="$p" ;;
      *)            target="$MEM/$area/$p" ;;
    esac
    case "$target" in
      "$MEM/$area/"*)
        [ -f "$target" ] || printf 'dangling|%s|%s\n' "$area" "$p" >> "$idx_tmp" ;;
    esac
  done
done
# 9b. locations pages follow references/places-index.md: YAML frontmatter
# (name/summary/updated), a "# " title, and ## Facts / ## Visits /
# ## Related sections. Auxiliary index files (*_INDEX.md) are not place
# pages and are exempt.
if [ -d "$MEM/locations" ]; then
  for f in "$MEM/locations/"*.md; do
    [ -e "$f" ] || continue
    bn="$(basename "$f")"
    [ "$bn" = "INDEX.md" ] && continue
    case "$bn" in *_INDEX.md) continue ;; esac
    slug="$bn"
    head -12 "$f" | grep -q '^name:' \
      || printf 'schema|%s|missing frontmatter name:\n' "$slug" >> "$idx_tmp"
    head -12 "$f" | grep -q '^summary:' \
      || printf 'schema|%s|missing frontmatter summary:\n' "$slug" >> "$idx_tmp"
    head -12 "$f" | grep -qE '^updated: [0-9]{4}-[0-9]{2}-[0-9]{2}' \
      || printf 'schema|%s|missing frontmatter updated: YYYY-MM-DD\n' "$slug" >> "$idx_tmp"
    grep -q '^# ' "$f" \
      || printf 'schema|%s|missing "# " title\n' "$slug" >> "$idx_tmp"
    grep -q '^## Facts' "$f" \
      || printf 'schema|%s|missing ## Facts\n' "$slug" >> "$idx_tmp"
    grep -q '^## Visits' "$f" \
      || printf 'schema|%s|missing ## Visits\n' "$slug" >> "$idx_tmp"
    grep -q '^## Related' "$f" \
      || printf 'schema|%s|missing ## Related\n' "$slug" >> "$idx_tmp"
  done
fi
if [ -s "$idx_tmp" ]; then
  while IFS='|' read -r kind area detail; do
    case "$kind" in
      dangling) flag "dangling ref in $area/INDEX.md -> $detail (page missing)" ;;
      schema)   flag "locations/$area schema: $detail" ;;
    esac
  done < "$idx_tmp"
else
  say "  ok — no dangling index refs; locations pages match the schema."
fi
rm -f "$idx_tmp"
say ""

# 10. router integrity (single-home rule) --------------------------------------
say "## 10. router integrity (MEMORY.md is a router, not a fact store)"
if [ -f "$ROOT/MEMORY.md" ]; then
  drift=0
  for h in "## Facts" "## Preferences" "## Commitments"; do
    if grep -q "^$h" "$ROOT/MEMORY.md"; then
      n="$(awk -v H="$h" '$0==H{f=1;next} f&&/^## /{exit} f&&NF{c++} END{print c+0}' "$ROOT/MEMORY.md")"
      if [ "$n" -gt 5 ]; then
        flag "MEMORY.md carries a substantive '$h' section ($n lines) — facts belong in their single-home topic/person/group page, not the router."
        drift=1
      fi
    fi
  done
  [ "$drift" -eq 0 ] && say "  ok — MEMORY.md is a thin router (identity + pointers, no fact sections)."
else
  say "  skipped — no MEMORY.md at $ROOT."
fi
say ""

# 11. retrieval query expectation staleness -----------------------------------
# Ground-truth maintenance (eval framework §1.3): when memory moves a fact
# to a new home, the v2 suite's expected home must follow with a changelog
# entry. A query whose expected home no longer contains the query terms is
# stale — it measures nothing. Added 2026-10-04 after the Sep-30
# single-home restructure left 16 queries expecting MEMORY.md (found via
# the MRR regression trip, fixed with changelog entries).
say "## 11. retrieval query expectation staleness (v2 suite ground truth)"
QFILE="${MEMORY_RETRIEVAL_QUERIES:-$ROOT/workspace/goals/daily-memory-refresh/hidden_files/retrieval-queries-v2.jsonl}"
if [ -f "$QFILE" ]; then
  stale_out="$(ROOT="$ROOT" QFILE="$QFILE" python3 - <<'PYEOF'
import json, os, re, sys
root = os.environ["ROOT"]
stale = []
try:
    recs = [json.loads(l) for l in open(os.environ["QFILE"], encoding="utf-8")
            if l.strip() and not l.startswith("#")]
except (OSError, ValueError) as e:
    print("ERROR|cannot parse query file: %s" % e)
    sys.exit(0)
for r in recs:
    qid, query, expected = r.get("id"), r.get("query", ""), r.get("expected") or []
    if not expected:
        continue  # abstention stratum: nothing to go stale
    try:
        rx = re.compile(query, re.IGNORECASE)
    except re.error:
        stale.append("%s|query is not a valid regex: %s" % (qid, query))
        continue
    for frag in expected:
        target = None
        for cand in (os.path.join(root, frag), os.path.join(root, frag + ".md"),
                     os.path.join(root, "memory", frag),
                     os.path.join(root, "memory", frag + ".md")):
            if os.path.isfile(cand):
                target = cand
                break
        if target is None:
            stale.append("%s|expected home missing from tree: %s" % (qid, frag))
            continue
        try:
            with open(target, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError:
            stale.append("%s|cannot read expected home: %s" % (qid, frag))
            continue
        if not rx.search(text):
            stale.append("%s|expected home no longer contains the query terms: %s" % (qid, frag))
for s in stale:
    print("STALE|" + s)
print("CHECKED|%d" % len(recs))
PYEOF
)"
  if printf '%s' "$stale_out" | grep -q '^ERROR|'; then
    flag "$(printf '%s' "$stale_out" | grep '^ERROR|' | cut -d'|' -f2- | head -1)"
  else
    n_stale="$(printf '%s' "$stale_out" | grep -c '^STALE|' || true)"
    n_checked="$(printf '%s' "$stale_out" | grep '^CHECKED|' | cut -d'|' -f2)"
    if [ "$n_stale" -gt 0 ]; then
      printf '%s' "$stale_out" | grep '^STALE|' | cut -d'|' -f2- | while IFS='|' read -r qid detail; do
        flag "stale v2 expectation [$qid]: $detail — re-home with a changelog entry (framework §1.3)."
      done
    else
      say "  ok — all $n_checked v2 queries have live expected homes."
    fi
  fi
else
  say "  skipped — v2 query file not found (set MEMORY_RETRIEVAL_QUERIES)."
fi
say ""

if [ "$ISSUES" -eq 0 ]; then
  echo "AUDIT RESULT: clean"
  exit 0
else
  echo "AUDIT RESULT: issues found (see ! items above)"
  exit 1
fi
