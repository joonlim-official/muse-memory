#!/usr/bin/env bash
# memory-grep: keyword search across the whole personal memory tree.
# Semantic search is for concepts; this is for exact identifiers —
# names, dates, confirmation numbers, addresses.
# Usage: memory-grep <pattern> [context-lines] | memory-grep --help
#   memory root defaults to $PERSONAL_MEMORY_ROOT, then $HOME.
#   Set $PERSONAL_MEMORY_PROFILE to also search the central profile
#   document (it lives outside the memory root by design).
#   Set $MEMORY_GREP_MAX_LINES to override the 80-line output cap
#   (the retrieval-test v2 harness lifts it to measure index recall;
#   interactive use keeps the cap).
set -u

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "usage: memory-grep <pattern> [context-lines]"
  echo "  Keyword search across the personal memory tree — for exact"
  echo "  identifiers (names, dates, confirmation numbers), not concepts."
  echo "  memory root defaults to \$PERSONAL_MEMORY_ROOT, then \$HOME."
  exit 0
fi

ROOT="${PERSONAL_MEMORY_ROOT:-$HOME}"
PATTERN="${1:?usage: memory-grep <pattern> [context-lines]}"
CTX="${2:-2}"
if command -v rg >/dev/null 2>&1; then
  SEARCH=(rg -n -i -C "$CTX" --no-heading)
else
  SEARCH=(grep -r -n -i -C "$CTX")
fi
TARGETS=(
  "$ROOT/MEMORY.md"
  "$ROOT/memory/personalization.md"
  "$ROOT/memory/INDEX.md"
  "$ROOT/memory/people"
  "$ROOT/memory/groups"
  "$ROOT/memory/topics"
  "$ROOT/memory/meetings"
  "$ROOT/memory/activities"
  "$ROOT/memory/interests"
  "$ROOT/memory/locations"
  "$ROOT/memory/trace"
  "$ROOT/memory/bank"
)
# daily logs, if any
for f in "$ROOT"/memory/20*.md; do [ -e "$f" ] && TARGETS+=("$f"); done
# central profile lives outside the memory root; include it when set
[ -n "${PERSONAL_MEMORY_PROFILE:-}" ] && [ -e "$PERSONAL_MEMORY_PROFILE" ] \
  && TARGETS+=("$PERSONAL_MEMORY_PROFILE")
# Sort before the cap so the truncated set is deterministic run-to-run.
# (rg's parallel traversal order is nondeterministic; an unsorted head -80
# could drop different lines on identical input — root cause of the
# 2026-09-20 "Taekwon Kids" flaky miss, diagnosed 2026-09-23.)
MAX_LINES="${MEMORY_GREP_MAX_LINES:-80}"
"${SEARCH[@]}" "$PATTERN" "${TARGETS[@]}" 2>/dev/null \
  | LC_ALL=C sort | head -"$MAX_LINES"
